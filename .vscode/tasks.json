{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMSIS Load+Run",
            "problemMatcher": [],
            "dependsOn": [
                "CMSIS Load",
                "CMSIS Run"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "CMSIS Load",
            "type": "shell",
            "command": "echo Skipping CMSIS Load: images are loaded by the FVP model when CMSIS Run starts.",
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMSIS Run",
            "type": "shell",
            "command": "FVP_MPS2_Cortex-M3",
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "args": [
                "-D",
                "--plugin",
                "${workspaceFolder}/GDBServer.so",
                "-C",
                "GDBServer.port=3333",
                "-f",
                "fvp-config.txt",
                "-a",
                "out/hello/avh/debug/hello.axf"
            ],
            "problemMatcher": []
        }
    ]
}
