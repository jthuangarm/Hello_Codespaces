{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Arm-FVP@pyOCD (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/hello/avh/debug/hello.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "set $psp = $PSP",
                "tbreak main"
            ],
            "customResetCommands": [
                "maintenance packet R00",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "FVP_MPS2_Cortex-M3",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${workspaceFolder}/GDBServer.so",
                    "-C",
                    "GDBServer.port=3333",
                    "-f",
                    "fvp-config.txt",
                    "-a",
                    "out/hello/avh/debug/hello.axf"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "Arm-FVP@pyOCD (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/hello/avh/debug/hello.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off"
            ],
            "customResetCommands": [
                "maintenance packet R00",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        }
    ]
}
